# Default: use your signed-in Codex agent as the worker. This does not need an API key.
RESEARCH_MODE=codex_handoff

# Optional API mode: any OpenAI-compatible provider is supported by browser-use's ChatOpenAI adapter.
LLM_MODEL=gpt-5-mini
LLM_API_KEY=
LLM_BASE_URL=https://api.openai.com/v1

# Local runtime defaults
DATABASE_URL=
BROWSER_HEADLESS=true
MAX_ACCOUNTS_PER_RUN=10
MAX_PROSPECTS_PER_ACCOUNT=3
TARGET_QUALIFIED_PROSPECTS_PER_RUN=10
QUALIFIED_PROSPECT_ALIGNMENT_THRESHOLD=0.45
MAX_CONCURRENT_AGENTS=2
AGENT_MAX_STEPS=12
AGENT_RETRIES=1
MODEL_STEP_BUDGET=250
STALE_AFTER_DAYS=30
FEEDBACK_MINIMUM_REVIEWS=10
